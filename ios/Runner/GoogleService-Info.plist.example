<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Download the real GoogleService-Info.plist from Firebase Console and save it
    as ios/Runner/GoogleService-Info.plist. That file is intentionally ignored.
  -->
  <key>PROJECT_ID</key>
  <string>YOUR_FIREBASE_PROJECT_ID</string>
  <key>BUNDLE_ID</key>
  <string>YOUR_IOS_BUNDLE_ID</string>
  <key>GOOGLE_APP_ID</key>
  <string>YOUR_GOOGLE_APP_ID</string>
  <key>API_KEY</key>
  <string>YOUR_FIREBASE_API_KEY</string>
</dict>
</plist>
